      {"big": "ich", "snd": "ихь", "img": "me", "text": "после i, e — мягко", "at": 1}], "say": [
      {"ru": "После а, о, у — твёрдо, как в слове «бух».", "cap": "После a, o, u — твёрдо: Buch [бу:х]"},
      {"ru": "После и, е — мягко, как в слове «ихь».", "cap": "После i, e — мягко: ich [ихь]"}]},

