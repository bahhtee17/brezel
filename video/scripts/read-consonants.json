    {"type": "image", "art": "consonant-team", "caption": "Несколько букв — один звук", "say": [
      {"ru": "Запомните пять сочетаний, и длинные слова перестанут пугать."}]},

    {"type": "rule", "big": "sch", "snd": "ш", "pill": "Сочетание 1 из 5", "trap": {"at": 1, "wrong": ["сх", "ск"]}, "say": [
      {"ru": "Первое сочетание: эс-цэ-ха. Три буквы, а звук один: «ш».", "cap": "Первое — sch. Три буквы, один звук: [ш]."},
      {"ru": "Не «сх» и не «ск».", "cap": "Не [сх] и не [ск]!"}]},
