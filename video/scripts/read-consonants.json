      {"ru": "Это слово значит «город».", "cap": "Stadt [штат] — «город»"}]},
    {"type": "word", "pill": "sp в начале = [шп]", "de": "sprechen", "seg": "*sp|r|e|ch|e|n", "snd": "шп|р|е|хь|е|н", "tr": "шпрехьен", "ru": "говорить", "img": "talk", "say": [
      {"ru": "И ещё пример:"}, {"de": "sprechen"},
      {"ru": "Это слово значит «говорить».", "cap": "sprechen [шпрехьен] — «говорить»"}]},

    {"type": "recap", "tiles": [["sch", "ш"], ["tsch", "ч"], ["ach", "х"], ["ich", "хь"], ["st · sp", "шт · шп"]], "say": [
      {"ru": "Повторим."},
      {"ru": "Эс-цэ-ха — это «ш».", "cap": "sch — [ш]"},
      {"ru": "С буквой тэ впереди — «ч».", "cap": "tsch — [ч]"},
      {"ru": "Цэ-ха после а, о, у — твёрдое «х».", "cap": "ch после a, o, u — [х]"},
      {"ru": "Цэ-ха после и, е — мягкое «хь».", "cap": "ch после i, e — [хь]"},
      {"ru": "Эс-тэ и эс-пэ в начале слова — «шт» и «шп».", "cap": "st, sp в начале — [шт], [шп]"}]},
    {"type": "quiz", "de": "Sprache", "seg": "*Sp|r|a|*ch|e", "snd": "шп|р|а:|х|е", "tr": "шпра:хе", "ru": "язык", "img": "language", "say": [
      {"ru": "А теперь вы. Прочитайте это слово вслух.", "cap": "А теперь вы. Прочитайте слово вслух!"},
      {"pause": 3},
      {"de": "Sprache"},
      {"ru": "Это слово значит «язык». В начале «шп», а после буквы а — твёрдое «х».", "cap": "Sprache [шпра:хе] — «язык». Sp — [шп], ch после a — [х]."}]},
    {"type": "outro", "pose": "happy", "say": [
      {"ru": "Отлично! Теперь закрепите правила: нажмите «Проверить себя».", "cap": "Отлично! Теперь закрепите правила в тренировке."},
      {"de": "Tschüs!"}]}
  ]
