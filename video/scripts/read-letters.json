{
  "id": "read-letters",
  "kicker": "Чтение · глава 2",
  "title": "Буквы-обманщики",
  "chips": ["W", "V", "J", "Z", "S", "ß", "H"],
  "scenes": [
    {"type": "title", "pose": "wave", "say": [
      {"ru": "Привет! Сегодня знакомимся с буквами-обманщиками."},
      {"ru": "Они выглядят знакомо, а читаются совсем иначе."}]},
    {"type": "image", "art": "letter-trickster", "caption": "Выглядят знакомо — читаются иначе", "say": [
      {"ru": "Таких букв всего семь. Запомните их, и читать станет легко."}]},

    {"type": "rule", "big": "W w", "snd": "в", "pill": "Буква 1 из 7", "trap": {"at": 1, "wrong": ["у"]}, "say": [
      {"ru": "Первая буква: вэ. Она читается как русское «в».", "cap": "Первая буква — W. Читается как [в]."},
      {"ru": "Не «у», как в английском!", "cap": "Не [у], как в английском!"}]},
    {"type": "word", "rule": "W w", "de": "wo", "seg": "*w|o", "snd": "в|о:", "tr": "во:", "ru": "где", "img": "qwhere", "say": [
      {"ru": "Например:"}, {"de": "wo"},
      {"ru": "Это слово значит «где».", "cap": "wo [во:] — «где»"}]},

    {"type": "rule", "big": "V v", "snd": "ф", "pill": "Буква 2 из 7", "trap": {"at": 1, "wrong": ["в"]}, "say": [
      {"ru": "Вторая буква: фау. Она читается как «ф».", "cap": "Вторая — V. Читается как [ф]."},
      {"ru": "Да-да, не «в», а именно «ф».", "cap": "Не [в], а именно [ф]!"}]},
    {"type": "word", "rule": "V v", "de": "vier", "seg": "*v|ie|r", "snd": "ф|и:|а", "tr": "фи:а", "ru": "четыре", "say": [
      {"ru": "Например:"}, {"de": "vier"},
      {"ru": "Это число четыре.", "cap": "vier [фи:а] — «четыре»"}]},

    {"type": "rule", "big": "J j", "snd": "й", "pill": "Буква 3 из 7", "trap": {"at": 1, "wrong": ["дж"]}, "say": [
      {"ru": "Третья буква: йот. Она читается как «й».", "cap": "Третья — J. Читается как [й]."},
      {"ru": "Не «дж», как в английском.", "cap": "Не [дж], как в английском."}]},
    {"type": "word", "rule": "J j", "de": "ja", "seg": "*j|a", "snd": "й|а:", "tr": "я:", "ru": "да", "img": "yes", "say": [
      {"ru": "Например:"}, {"de": "ja"},
      {"ru": "Это слово значит «да».", "cap": "ja [я:] — «да»"}]},

    {"type": "rule", "big": "Z z", "snd": "ц", "pill": "Буква 4 из 7", "trap": {"at": 1, "wrong": ["з"]}, "say": [
      {"ru": "Четвёртая буква: цэт. Она всегда читается как «ц».", "cap": "Четвёртая — Z. Всегда читается как [ц]."},
      {"ru": "И никогда как «з».", "cap": "И никогда как [з]."}]},
    {"type": "word", "rule": "Z z", "de": "jetzt", "seg": "j|e|*tz|t", "snd": "й|е|ц|т", "tr": "йецт", "ru": "сейчас", "img": "clock", "say": [
      {"ru": "Например:"}, {"de": "jetzt"},
      {"ru": "Это слово значит «сейчас». Сочетание тэ-цэт тоже читается как «ц».", "cap": "jetzt [йецт] — «сейчас». tz — тоже [ц]."}]},

    {"type": "rule", "big": "S s", "snd": "з · с", "pill": "Буква 5 из 7", "say": [
      {"ru": "Пятая буква: эс. У неё два звука.", "cap": "Пятая — S. У неё два звука."},
      {"ru": "Перед гласной она читается как «з».", "cap": "Перед гласной — [з]."},
      {"ru": "А в конце слова и перед согласной — как «с».", "cap": "В конце слова и перед согласной — [с]."}]},
    {"type": "word", "pill": "S перед гласной = [з]", "de": "sie", "seg": "*s|ie", "snd": "з|и:", "tr": "зи:", "ru": "она", "img": "she", "say": [
      {"ru": "Вот эс перед гласной:", "cap": "Вот S перед гласной:"}, {"de": "sie"},
      {"ru": "Это слово значит «она».", "cap": "sie [зи:] — «она»"}]},
    {"type": "word", "pill": "S в конце = [с]", "de": "was", "seg": "w|a|*s", "snd": "в|а|с", "tr": "вас", "ru": "что", "img": "qwhat", "say": [
      {"ru": "А вот эс в конце слова:", "cap": "А вот S в конце слова:"}, {"de": "was"},
      {"ru": "Это слово значит «что».", "cap": "was [вас] — «что»"}]},

    {"type": "rule", "big": "ß", "snd": "с", "pill": "Буква 6 из 7", "trap": {"at": 1, "wrong": ["б", "в"]}, "say": [
      {"ru": "Шестая буква: эсцет. Такой буквы в русском нет.", "cap": "Шестая — ß, «эсцет»."},
      {"ru": "Она похожа на «бэ», но читается как «с».", "cap": "Похожа на «В», но читается как [с]."}]},
    {"type": "word", "rule": "ß", "de": "groß", "seg": "g|r|o|*ß", "snd": "г|р|о:|с", "tr": "гро:с", "ru": "большой", "say": [
      {"ru": "Например:"}, {"de": "groß"},
      {"ru": "Это слово значит «большой».", "cap": "groß [гро:с] — «большой»"}]},

    {"type": "rule", "big": "H h", "snd": "х", "pill": "Буква 7 из 7", "note": "после гласной не читается", "noteAt": 1, "say": [
      {"ru": "Седьмая буква: ха. В начале слова это лёгкий выдох.", "cap": "Седьмая — H. В начале слова — лёгкий выдох [х]."},
      {"ru": "А после гласной она не читается, зато гласная звучит долго.", "cap": "После гласной H не читается — гласная звучит долго."}]},
    {"type": "word", "pill": "H в начале = [х]", "de": "Hallo", "seg": "*H|a|ll|o", "snd": "х|а|л|о:", "tr": "хало:", "ru": "привет", "img": "wave", "say": [
      {"ru": "Вот ха в начале слова:", "cap": "Вот H в начале слова:"}, {"de": "Hallo"},
      {"ru": "Это, конечно, «привет».", "cap": "Hallo [хало:] — «привет»"}]},
    {"type": "word", "pill": "H после гласной молчит", "de": "wohnen", "seg": "w|*oh|n|e|n", "snd": "в|о:|н|е|н", "tr": "во:нен", "ru": "жить", "img": "house", "say": [
      {"ru": "А здесь ха не читается:", "cap": "А здесь H не читается:"}, {"de": "wohnen"},
      {"ru": "Это слово значит «жить».", "cap": "wohnen [во:нен] — «жить»"}]},

    {"type": "recap", "tiles": [["W", "в", 1], ["V", "ф", 1], ["J", "й", 2], ["Z", "ц", 2], ["S", "з · с", 3], ["ß", "с", 3], ["H", "х", 4]], "say": [
      {"ru": "Повторим."},
      {"ru": "Вэ читается как «в», а фау — как «ф».", "cap": "W — [в], V — [ф]"},
      {"ru": "Йот читается как «й», а цэт — как «ц».", "cap": "J — [й], Z — [ц]"},
      {"ru": "Эс — это «з» или «с», а эсцет — всегда «с».", "cap": "S — [з] или [с], ß — [с]"},
      {"ru": "А буква ха — это лёгкий выдох.", "cap": "H — лёгкий выдох [х]"}]},
    {"type": "quiz", "de": "Vorname", "seg": "*V|o|r|n|a|m|e", "snd": "ф|о:|р|н|а:|м|е", "tr": "фо:рна:ме", "ru": "имя", "img": "nametagFirst", "say": [
      {"ru": "А теперь вы. Прочитайте это слово вслух.", "cap": "А теперь вы. Прочитайте слово вслух!"},
      {"pause": 3},
      {"de": "Vorname"},
      {"ru": "Это слово значит «имя». Буква фау читается как «ф».", "cap": "Vorname [фо:рна:ме] — «имя». V — [ф]."}]},
    {"type": "outro", "pose": "happy", "say": [
      {"ru": "Отлично! Теперь закрепите правила: нажмите «Проверить себя».", "cap": "Отлично! Теперь закрепите правила в тренировке."},
      {"de": "Tschüs!"}]}
  ]
}
